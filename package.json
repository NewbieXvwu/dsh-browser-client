{
  "name": "dsh-browser-host",
  "version": "0.3.2",
  "description": "DSH host bridge for the DSH Browser Client extension: serves the real DSH WebUI to the browser floating window at /browser-ui/ (same boot graph, embedded layout) with a token-authenticated /ext-api RPC proxy, a /browser-ui-mux WebSocket bridge to /api/remote.mux, a Cordis event pump and a bidirectional /ext-api-control channel for page_* tools. Targets DSH 0.2.2 client-connection.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1"
  }
}
